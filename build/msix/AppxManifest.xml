<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store で配る MSIX の設計図 (#176)。build.cmd -Msix が {VERSION} を埋めて使う。

  **Identity の Name と Publisher、PublisherDisplayName は Partner Center の
  「製品 ID」に出た値そのもの。**大文字小文字まで一致していないと申請が通らない。
  バージョンの 4 つ目は Store が使うので 0 にする。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="Pstudio.Expzip"
    Publisher="CN=97F27945-B936-4DAE-B1B2-53E7910B53CF"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Expzip</DisplayName>
    <PublisherDisplayName>P studio</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- 対象は Windows 10/11 (docs/SPEC.md 1章)。MSIX を入れられるのは 1809 から -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Expzip" Executable="Expzip.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Expzip"
        Description="Windows 向けのアーカイバ (書庫ソフト)"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <!--
        Store 版だけの関連付け (#176)。exe 単体の版はレジストリを書かないので持たない。
        入れると「プログラムから開く」の候補に出る。既定にするかは利用者が選ぶ。

        拡張子は src/Expzip.Core/Archives/ArchiveFormat.cs の表から。Windows は最後の
        拡張子しか見ないので、.tar.gz などは .gz として宣言する。tar でない .gz も
        中身 1 個の書庫として開ける (#256) ので、どちらも開ける。
        自己解凍書庫 (.exe) と分割ファイル (.001) は入れない
      -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="archive">
            <uap:SupportedFileTypes>
              <uap:FileType>.zip</uap:FileType>
              <uap:FileType>.7z</uap:FileType>
              <uap:FileType>.tar</uap:FileType>
              <uap:FileType>.tgz</uap:FileType>
              <uap:FileType>.tbz</uap:FileType>
              <uap:FileType>.tbz2</uap:FileType>
              <uap:FileType>.txz</uap:FileType>
              <uap:FileType>.tzst</uap:FileType>
              <uap:FileType>.gz</uap:FileType>
              <uap:FileType>.bz2</uap:FileType>
              <uap:FileType>.xz</uap:FileType>
              <uap:FileType>.zst</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>

        <!--
          コマンドラインから Expzip.exe の名前で呼ぶため (#316)。
          Store 版の実体はパスを書いて直接起動できない場所にある
        -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Expzip.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="Expzip.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <!-- ふつうのデスクトップアプリとして動かす。これが無いと exe を起動できない -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
