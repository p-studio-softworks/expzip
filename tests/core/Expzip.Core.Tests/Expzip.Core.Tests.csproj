<Project Sdk="Microsoft.NET.Sdk">

  <!--
    画面を通さずに Core を直接呼ぶテスト (#332)。配る exe には入らない。
    走らせ方: tests\core\Run-CoreTests.ps1
    xUnit v3 のテストは、それ自体が実行できるプログラムになる。dotnet test は使わない
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Expzip.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 版は固定する。使わないパッケージ (coverlet など) は入れない -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Expzip.Core\Expzip.Core.csproj" />
  </ItemGroup>

</Project>
