<Window x:Class="Expzip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:archives="clr-namespace:Expzip.Archives"
        xmlns:ui="clr-namespace:Expzip.Ui"
        Title="Expzip"
        Height="620" Width="960"
        MinHeight="360" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- フォルダの黄色。エクスプローラーの配色に寄せる -->
        <SolidColorBrush x:Key="FolderBrush" Color="#E8B44A" />
        <SolidColorBrush x:Key="FileBrush" Color="#7A7A7A" />
        <!--
            警告色 (#36) と保護された項目の色 (#20) は App.xaml にある。
            検査結果の画面 (#57) から同じものを使うため
        -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 名前の書き換え中だけ入れ替えるため、真偽を反転した表示切り替えも要る (#15) -->
        <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- 文言は言語に合わせて ApplyLanguage が入れる (#23) -->
        <ToolTip x:Key="SuspiciousPathTooltip">
            <TextBlock TextWrapping="Wrap" />
        </ToolTip>
        <ToolTip x:Key="EncryptedTooltip">
            <TextBlock TextWrapping="Wrap" />
        </ToolTip>

        <!--
            アドレスバーの区切り (#90)。エクスプローラーと同じく、枠も影も無く、
            指した場所だけが色付く。押せるものだと分かるのは動きだけなので、
            当たり判定と地色の変わり方はそちらに合わせる
        -->
        <Style x:Key="CrumbButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 一覧の選択と同じ薄い青。同じ窓で色の意味を変えない -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#D9F4FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="#D9F4FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CrumbGlyph" TargetType="Button" BasedOn="{StaticResource CrumbButton}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}" />
        </Style>

        <!--
            ツールバーの絵 (#102)。エクスプローラーと同じく、口には絵だけを置く。
            Segoe MDL2 Assets は**字**なので、どの大きさ・どの画面の細かさでも
            輪郭が崩れない。大きさを変えたくなったら FontSize のここ一行で足りる。

            ToolBar は中の口に自前の見た目を当てる。型を直に指すとそれを外して
            しまうので、必ずそちらを土台にする。

            押せないときも説明を出す。絵だけの口が灰色で並んでいると、
            それが何なのかを確かめる手立てが説明のほかに無い
        -->
        <Style x:Key="ToolGlyph" TargetType="Button"
               BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>

        <!--
            名前の色。保護された項目だけ色を変える (#20)。
            ツリーと一覧で同じ見え方にするため、ひとつの型を両方から使う
        -->
        <Style x:Key="EntryNameText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEncrypted}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource EncryptedBrush}" />
                    <Setter Property="ToolTip" Value="{StaticResource EncryptedTooltip}" />
                </DataTrigger>
                <!--
                    ルールに合っていない印 (#92)。ツリー (#88) と同じ地色にする。
                    **同じことを2つの見た目で出さない。**旗と地色が混ざっていると、
                    別の意味があるように見える
                -->
                <DataTrigger Binding="{Binding BreaksRules}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RuleBreakBackBrush}" />
                    <Setter Property="ToolTip" Value="{Binding RuleTooltip}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FolderNameText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasEncryptedContent}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource EncryptedBrush}" />
                    <Setter Property="ToolTip" Value="{StaticResource EncryptedTooltip}" />
                </DataTrigger>
                <!--
                    ルールに合っていない印 (#88)。**名前の地色を変える。**
                    旗を前に置くと1文字ぶん名前がずれ、兄弟のフォルダと段が違って
                    見える。ツリーは段で親子を読ませる絵なので、そこは狂わせない。
                    説明にはフォルダごとの中身が入る。**何が合っていないのかを、
                    結果の窓を開き直さずに読めるようにする**
                -->
                <DataTrigger Binding="{Binding BreaksRules}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RuleBreakBackBrush}" />
                    <Setter Property="ToolTip" Value="{Binding RuleTooltip}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
        エクスプローラーライクな基本レイアウト (docs/SPEC.md 4.1節)。
        上から ツールバー / アドレスバー / [タブバー] / ツリー+リスト / ステータスバー。
        タブバーはフェーズ3で アドレスバーの下 に追加する (#22)。
    -->
    <DockPanel>

        <!-- ツールバー -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar ToolBarTray.IsLocked="True" Loaded="ToolBar_Loaded">
                <!--
                    絵は XAML に、名前と説明は ApplyLanguage に (#23, #102)。
                    絵は言語で変わらないので分けてある。名前 (AutomationProperties.Name) は
                    **絵だけの口に文字を残すためのもの**で、支援技術と画面を操作するテストは
                    これを見る。入れ忘れると記号がそのまま読み上げられる
                -->
                <!-- OpenFile。書類が開く形 -->
                <Button x:Name="OpenButton" Click="OpenButton_Click"
                        Style="{StaticResource ToolGlyph}" Content="&#xE8E5;" />
                <!-- 最近使った書庫 (#10)。開くの隣に畳んで置く -->
                <Button x:Name="RecentButton" Click="RecentButton_Click" Padding="5,0">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    <Button.ContextMenu>
                        <ContextMenu />
                    </Button.ContextMenu>
                </Button>
                <Separator />
                <!-- Download。書庫から外へ取り出す向き -->
                <Button x:Name="ExtractButton" Click="ExtractButton_Click" IsEnabled="False"
                        Style="{StaticResource ToolGlyph}" Content="&#xE896;" />
                <!-- Add -->
                <Button x:Name="AddButton" Click="AddButton_Click" IsEnabled="False"
                        Style="{StaticResource ToolGlyph}" Content="&#xE710;" />
                <Separator />
                <!--
                    更新ボタンは置かない (#64)。外で書庫が書き換わったら自分で読み直す。
                    念のための読み直しは F5 と右クリックメニューに残してある
                -->
                <!-- 書庫のパスワードを付ける・変える・外す (#63) -->
                <!-- Lock。錠前 -->
                <Button x:Name="PasswordButton" Click="PasswordButton_Click" IsEnabled="False"
                        Style="{StaticResource ToolGlyph}" Content="&#xE72E;" />
                <!--
                    書庫の中の書庫を、親の書庫へ書き戻す (#30)。ネスト書庫のタブでだけ出す。
                    ふだんの書き換えはその場で書庫に入るため、保存という操作そのものが無い
                -->
                <!-- Save。名前を付けて保存に変わっても絵は同じ。違いは説明で出す -->
                <Button x:Name="SaveButton" Click="SaveButton_Click"
                        IsEnabled="False" Visibility="Collapsed"
                        Style="{StaticResource ToolGlyph}" Content="&#xE74E;" />
                <Separator />
                <!--
                    書庫検査 (#53)。押したときだけ走る。書庫を丸ごと読むため、
                    開くたびに走らせると開く速さが中身の大きさに引きずられる
                -->
                <!-- Shield。検査は中身を探すのでなく、無事かどうかを見る操作 -->
                <Button x:Name="InspectButton" Click="InspectButton_Click" IsEnabled="False"
                        Style="{StaticResource ToolGlyph}" Content="&#xEA18;" />
                <!--
                    ファイルの分割 (#59)。書庫でなくても分けられるので、
                    書庫を開いていなくても押せる
                -->
                <!-- Cut。はさみ -->
                <Button x:Name="SplitButton" Click="SplitButton_Click"
                        Style="{StaticResource ToolGlyph}" Content="&#xE8C6;" />
                <!--
                    自己解凍書庫として書き出す (#29)。取り出すプログラムを前に付けた
                    実行ファイルにする。受け取った人は Expzip が無くても取り出せる
                -->
                <!-- Package。それだけで開ける包み -->
                <Button x:Name="SfxButton" Click="SfxButton_Click" IsEnabled="False"
                        Style="{StaticResource ToolGlyph}" Content="&#xE7B8;" />
                <Separator />
                <!--
                    AI の機能 (#104)。歯車ひとつに言語といっしょに入れていたが、
                    **性質の違うものが1つの口に同居していた。**開くまで何が出てくるか
                    分からないので、口を分ける
                -->
                <!-- Robot -->
                <Button x:Name="AiButton" Click="AiButton_Click"
                        Style="{StaticResource ToolGlyph}" Content="&#xE99A;">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <!-- AI 連携の繋ぎ先 (#24)。設定していなければ機能を出さない -->
                            <MenuItem x:Name="AiSettingsItem" Click="AiSettingsItem_Click" />
                            <Separator />
                            <!--
                                お手本からルールを学ぶ (#25)。繋ぎ先が未設定なら押せない
                                (仕様書 10.4節)。灰色の項目が何なのか分からないままに
                                ならないよう、押せないときも説明を出す
                            -->
                            <MenuItem x:Name="RuleLearnItem" Click="RuleLearnItem_Click"
                                      ToolTipService.ShowOnDisabled="True" />
                            <!--
                                保存した決まりを、いま見ている書庫に当てて出す (#27)。
                                こちらは AI を使わないので、繋ぎ先が無くても押せる
                            -->
                            <MenuItem x:Name="RuleAuditItem" Click="RuleAuditItem_Click"
                                      ToolTipService.ShowOnDisabled="True" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <!--
                    言語 (#23, #104)。口そのものが言語なので、中で入れ子にしない。
                    LocaleLanguage。Windows が言語に使っている絵
                -->
                <Button x:Name="LanguageButton" Click="LanguageButton_Click"
                        Style="{StaticResource ToolGlyph}" Content="&#xF2B7;">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="LanguageAutoItem" IsCheckable="True"
                                      Tag="auto" Click="LanguageItem_Click" />
                            <Separator />
                            <MenuItem x:Name="LanguageJapaneseItem" IsCheckable="True"
                                      Tag="ja" Click="LanguageItem_Click" />
                            <MenuItem x:Name="LanguageEnglishItem" IsCheckable="True"
                                      Tag="en" Click="LanguageItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <!-- バージョン情報 (#104)。Info。押すとその場で窓が出る -->
                <Button x:Name="AboutButton" Click="AboutButton_Click"
                        Style="{StaticResource ToolGlyph}" Content="&#xE946;" />
            </ToolBar>
        </ToolBarTray>

        <!--
            アドレスバー (#90)。いまの場所を、エクスプローラーと同じく
            **区切りごとに押せる形**で出す。パスの文字そのものはタイトルバーに出す。

            文字の欄は消さずに**下に敷いてある。**空きを押すと上の帯が引っ込んで
            現れ、選んで写せる。支援技術から見た「場所」もこの欄のままになる
        -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <Border Background="{x:Static SystemColors.WindowBrush}"
                    BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                    BorderThickness="1"
                    MinHeight="24">
                <Grid>
                    <TextBox x:Name="AddressBar"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             BorderThickness="0"
                             Padding="6,2"
                             VerticalContentAlignment="Center"
                             PreviewKeyDown="AddressBar_PreviewKeyDown"
                             LostKeyboardFocus="AddressBar_LostFocus" />
                    <DockPanel x:Name="CrumbBar"
                               Background="{x:Static SystemColors.WindowBrush}"
                               MouseLeftButtonDown="CrumbBar_MouseDown">
                        <!-- 収まらないときだけ出る。畳んだところはここから辿れる -->
                        <Button x:Name="CrumbOverflow"
                                DockPanel.Dock="Left"
                                Visibility="Collapsed"
                                Content="&#xE712;"
                                Style="{StaticResource CrumbGlyph}"
                                Click="CrumbOverflow_Click" />
                        <ScrollViewer x:Name="CrumbScroll"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Focusable="False"
                                      SizeChanged="CrumbScroll_SizeChanged">
                            <ItemsControl x:Name="Crumbs">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!--
                                                中身が絵と文字の組なので、名前を
                                                入れておかないと支援技術には
                                                何も読まれない
                                            -->
                                            <Button Style="{StaticResource CrumbButton}"
                                                    Tag="{Binding Path}"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    Click="Crumb_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- 先頭 (書庫そのもの) にだけ付く -->
                                                    <TextBlock Text="&#xE7B8;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               Margin="0,0,5,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource FolderBrush}"
                                                               Visibility="{Binding IsArchive,
                                                                            Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Name}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <!--
                                                この場所の中にあるフォルダを出す。
                                                エクスプローラーと同じく、区切りそのものが口になる
                                            -->
                                            <Button Style="{StaticResource CrumbGlyph}"
                                                    Content="&#xE76C;"
                                                    Tag="{Binding Path}"
                                                    AutomationProperties.Name="{Binding Inside}"
                                                    Click="CrumbInside_Click"
                                                    Visibility="{Binding HasFolders,
                                                                 Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Border>

        <!--
            タブバー: 書庫ごとに1タブ (#22)。中身の表示はタブごとに作らず、
            ツリーと一覧の1組を使い回して差し替える。TabControl の見た目は
            見出しの帯だけにしてある
        -->
        <Border DockPanel.Dock="Top"
                Background="{x:Static SystemColors.ControlBrush}"
                BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TabControl x:Name="ArchiveTabs"
                            Margin="4,4,0,0"
                            SelectionChanged="ArchiveTabs_SelectionChanged"
                            PreviewMouseDown="ArchiveTabs_PreviewMouseDown">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True" />
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.ItemContainerStyle>
                        <!--
                            タブの名前を支援技術に伝える。既定では型名がそのまま
                            読み上げられ、どの書庫のタブか分からない
                        -->
                        <Style TargetType="TabItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </TabControl.ItemContainerStyle>
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ui:ArchiveTab}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        <!-- 閉じるボタン。エクスプローラーやブラウザと同じ位置に置く -->
                        <Button Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="9"
                                Width="18" Height="18"
                                Margin="8,0,-4,0"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                ToolTip="{Binding CloseTooltip}"
                                AutomationProperties.Name="{Binding CloseTooltip}"
                                Click="CloseTabButton_Click" />
                    </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>

                <!--
                    エクスプローラーと同じく、タブの右で新しい書庫を作る (#22)。
                    以前ツールバーにあった「新規作成」はここに移した。
                    タブの中に置くと、WPF の TabControl は中の部品を
                    支援技術に見せないため、外に出してある
                -->
                <Button x:Name="NewTabButton"
                        Content="&#xE710;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Width="24" Height="22"
                        Margin="4,4,4,0"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        VerticalAlignment="Bottom"
                        Click="NewTabButton_Click" />
            </StackPanel>
        </Border>

        <!-- ステータスバー: 選択数 / 合計サイズ / 進捗 -->
        <StatusBar DockPanel.Dock="Bottom">
            <!-- 進捗と中断は右端に寄せるため、あえて先頭に記述している -->
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="ProgressIndicator"
                                 Width="150" Height="14"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                    <!-- 処理中だけ現れる (#37) -->
                    <Button x:Name="CancelButton"
                            Click="CancelButton_Click"
                            Margin="8,0,0,0"
                            Padding="10,1"
                            Visibility="Collapsed" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusMessage" />
            </StatusBarItem>
            <!-- パスが通常ではない項目を含む書庫を開いたときだけ出す (#36) -->
            <StatusBarItem x:Name="SuspiciousWarningItem" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE814;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,4,0" />
                    <TextBlock x:Name="SuspiciousWarningText"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="SelectionInfo" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="TotalSizeInfo" />
            </StatusBarItem>
        </StatusBar>

        <!-- 本体: 左にフォルダ階層、右にファイル一覧 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="240" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree"
                      Grid.Column="0"
                      BorderThickness="0"
                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="FolderTree_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="FolderTree_PreviewMouseMove"
                      PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                      ContextMenuOpening="FolderTree_ContextMenuOpening"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <!-- ツリー側からもフォルダを作れるようにする (#50) -->
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="TreeNewFolderMenuItem"
                                  InputGestureText="Ctrl+Shift+N"
                                  Click="NewFolderMenuItem_Click" />
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <!--
                            節の名前。入れておかないと、支援技術には束ねている型の名前
                            (Expzip.Archives.ArchiveFolder) がそのまま読まれる。
                            一覧と同じく、付いている印の意味も入れる (#119)
                        -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding RowName}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <!--
                        選ばれている節の色 (#20)。WPF の既定では濃い青地に白文字になり、
                        保護された項目の緑が読めなくなる。一覧側は薄い青地のまま文字色を
                        変えないため、同じ窓の中で選択の見え方も食い違っていた。
                        エクスプローラーも薄い青地なので、そちらに合わせる。
                        一覧が使っている色をそのまま置く (実測 #98DDFB を挟む階調)
                    -->
                    <LinearGradientBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D9F4FF" Offset="0" />
                        <GradientStop Color="#9BDDFB" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                     Color="{x:Static SystemColors.ControlTextColor}" />
                    <!-- 焦点が一覧へ移っている間。エクスプローラーと同じく薄い灰色 -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                     Color="#F0F0F0" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                     Color="{x:Static SystemColors.ControlTextColor}" />
                    <HierarchicalDataTemplate DataType="{x:Type archives:ArchiveFolder}"
                                              ItemsSource="{Binding Folders}">
                        <StackPanel Orientation="Horizontal">
                            <!--
                                ルールに合っていない印 (#87) は、名前の地色で出す
                                (#88、FolderNameText)。**配下のどこかにあれば、
                                ここにも出る。**でないと、開いて回らないと気付けない
                            -->
                            <!--
                                パスが通常ではないフォルダに警告を添える (#36)。
                                絵は支援技術の木に出さない (#119、GlyphText)。
                                伝えたい事柄は節の名前に入れてある
                            -->
                            <ui:GlyphText Text="&#xE814;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12"
                                          Foreground="{StaticResource WarningBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"
                                          ToolTip="{StaticResource SuspiciousPathTooltip}"
                                          Visibility="{Binding IsPathSuspicious, Converter={StaticResource BoolToVisibility}}" />
                            <!-- 塗りつぶしのフォルダ。輪郭線のみだと書類と紛らわしい -->
                            <ui:GlyphText Text="&#xE8D5;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="13"
                                          Foreground="{StaticResource FolderBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                            <!--
                                地色を敷いたときに文字が縁にくっつかないよう、
                                余白を取る。**どの節にも同じだけ**取るので、段はずれない
                            -->
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       Padding="3,0"
                                       Style="{StaticResource FolderNameText}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{x:Static SystemColors.ControlBrush}"
                          ShowsPreview="False" />

            <Grid Grid.Column="2">
                <!--
                    数万ファイル規模の書庫でも固まらないよう、UI 仮想化を明示的に
                    有効化している (docs/SPEC.md 6章, #14)。
                -->
                <ListView x:Name="EntryList"
                          BorderThickness="0"
                          AllowDrop="True"
                          DragOver="EntryList_DragOver"
                          Drop="EntryList_Drop"
                          SelectionChanged="EntryList_SelectionChanged"
                          PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="EntryList_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="EntryList_PreviewMouseMove"
                          MouseDoubleClick="EntryList_MouseDoubleClick"
                          KeyDown="EntryList_KeyDown"
                          ContextMenuOpening="EntryList_ContextMenuOpening"
                          GridViewColumnHeader.Click="EntryList_ColumnHeaderClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.IsDeferredScrollingEnabled="False">
                    <!--
                        行の名前。入れておかないと、支援技術には束ねている型の名前が
                        そのまま読まれる (#109)。**行に付く印の意味も名前に入れる**
                        (#119)。色と絵だけでは、読み上げにも、色の見え方が違う人にも
                        伝わらない
                    -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="AutomationProperties.Name"
                                    Value="{Binding RowName}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <!-- アプリ内のコンテキストメニュー。OSシェルへの統合はしない -->
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <!--
                                一時フォルダへ取り出して既定のアプリに渡す (#12)。
                                保存されたら書庫へ書き戻すか尋ねる (#16, #52)
                            -->
                            <MenuItem x:Name="OpenMenuItem"
                                      InputGestureText="Enter"
                                      FontWeight="Bold"
                                      Click="OpenMenuItem_Click" />
                            <Separator />
                            <!-- 書庫内の名前を変える (#15) -->
                            <MenuItem x:Name="RenameMenuItem"
                                      InputGestureText="F2"
                                      Click="RenameMenuItem_Click" />
                            <MenuItem x:Name="DeleteMenuItem"
                                      InputGestureText="Del"
                                      Click="DeleteMenuItem_Click" />
                            <Separator />
                            <!-- 書庫の中に空のフォルダを作る (#50) -->
                            <MenuItem x:Name="NewFolderMenuItem"
                                      InputGestureText="Ctrl+Shift+N"
                                      Click="NewFolderMenuItem_Click" />
                            <Separator />
                            <!--
                                書庫を読み直す (#64)。ふだんは自分で読み直すので要らないが、
                                エクスプローラーと同じくここと F5 に残す
                            -->
                            <MenuItem x:Name="RefreshMenuItem"
                                      InputGestureText="F5"
                                      Click="RefreshMenuItem_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.Resources>
                        <!--
                            エクスプローラーに合わせて列見出しを左揃えにする。
                            既定では中央揃えになり、見た目が大きく異なる。
                        -->
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Padding" Value="6,2" />
                        </Style>
                        <!-- 数値列は見出しも値も右揃えにして桁を読みやすくする -->
                        <Style x:Key="NumericHeader" TargetType="GridViewColumnHeader"
                               BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                        </Style>

                        <DataTemplate x:Key="NameCell">
                            <StackPanel Orientation="Horizontal">
                                <!--
                                    ルールに合っていない印は、名前の地色で出す
                                    (#92、EntryNameText)。ツリーと同じ形にする。
                                    旗と地色が混ざっていると、同じことなのに
                                    2つの意味があるように見える
                                -->
                                <!--
                                    パスが通常ではない項目に警告を添える (#36)。
                                    絵は支援技術の木に出さない (#119、GlyphText)。
                                    伝えたい事柄は行の名前に入れてある
                                -->
                                <ui:GlyphText Text="{Binding WarningGlyph}"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="12"
                                              Foreground="{StaticResource WarningBrush}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0"
                                              ToolTip="{Binding WarningTooltip}"
                                              Visibility="{Binding IsPathSuspicious, Converter={StaticResource BoolToVisibility}}" />
                                <ui:GlyphText Text="{Binding Glyph}"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="13"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource FolderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="File">
                                                    <Setter Property="Foreground" Value="{StaticResource FileBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </ui:GlyphText>
                                <!-- 通常は表示のみ。名前の変更中だけ入力欄に入れ替える (#15) -->
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           Padding="3,0"
                                           Style="{StaticResource EntryNameText}"
                                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                                <!-- 名前と同じ余白にする。入れ替わった拍子に字が動かないように -->
                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="120"
                                         Padding="3,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                         Loaded="RenameBox_Loaded"
                                         IsVisibleChanged="RenameBox_IsVisibleChanged"
                                         KeyDown="RenameBox_KeyDown"
                                         LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                            </StackPanel>
                        </DataTemplate>

                        <DataTemplate x:Key="SizeCell">
                            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" MinWidth="80" />
                        </DataTemplate>
                        <DataTemplate x:Key="CompressedCell">
                            <TextBlock Text="{Binding CompressedText}" TextAlignment="Right" MinWidth="80" />
                        </DataTemplate>
                        <DataTemplate x:Key="RatioCell">
                            <TextBlock Text="{Binding RatioText}" TextAlignment="Right" MinWidth="50" />
                        </DataTemplate>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <!-- 既定のウィンドウ幅で5列が収まるようにしてある (合計700) -->
                            <GridViewColumn x:Name="NameColumn"       Width="280" CellTemplate="{StaticResource NameCell}" />
                            <GridViewColumn x:Name="SizeColumn"       Width="100" CellTemplate="{StaticResource SizeCell}"
                                            HeaderContainerStyle="{StaticResource NumericHeader}" />
                            <GridViewColumn x:Name="CompressedColumn" Width="100" CellTemplate="{StaticResource CompressedCell}"
                                            HeaderContainerStyle="{StaticResource NumericHeader}" />
                            <GridViewColumn x:Name="RatioColumn"      Width="70"  CellTemplate="{StaticResource RatioCell}"
                                            HeaderContainerStyle="{StaticResource NumericHeader}" />
                            <GridViewColumn x:Name="DateColumn"       Width="150" DisplayMemberBinding="{Binding DateText}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 書庫が開かれていないときの案内。項目を表示したら隠す -->
                <TextBlock x:Name="EmptyStateMessage"
                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>

    </DockPanel>
</Window>
