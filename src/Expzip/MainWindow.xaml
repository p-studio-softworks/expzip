<Window x:Class="Expzip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:archives="clr-namespace:Expzip.Archives"
        Title="Expzip"
        Height="620" Width="960"
        MinHeight="360" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- フォルダの黄色。エクスプローラーの配色に寄せる -->
        <SolidColorBrush x:Key="FolderBrush" Color="#E8B44A" />
        <SolidColorBrush x:Key="FileBrush" Color="#7A7A7A" />
        <!-- パスが通常ではない項目の警告色 (#36) -->
        <SolidColorBrush x:Key="WarningBrush" Color="#C42B1C" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <ToolTip x:Key="SuspiciousPathTooltip">
            <TextBlock>
                このパスは通常の書庫では使われない形式です。<LineBreak />
                展開しても、選んだフォルダの外には書き出されません。
            </TextBlock>
        </ToolTip>
    </Window.Resources>

    <!--
        エクスプローラーライクな基本レイアウト (docs/SPEC.md 5.1節)。
        上から ツールバー / アドレスバー / [タブバー] / ツリー+リスト / ステータスバー。
        タブバーはフェーズ3で アドレスバーの下 に追加する (#22)。
    -->
    <DockPanel>

        <!-- ツールバー -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar ToolBarTray.IsLocked="True" Loaded="ToolBar_Loaded">
                <Button x:Name="OpenButton"    Content="開く"     Click="OpenButton_Click"    ToolTip="書庫を開く" />
                <!-- 最近使った書庫 (#10)。開くの隣に畳んで置く -->
                <Button x:Name="RecentButton" Click="RecentButton_Click" Padding="5,0" ToolTip="最近使った書庫">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    <Button.ContextMenu>
                        <ContextMenu />
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="NewButton"     Content="新規作成" Click="NewButton_Click"     ToolTip="空の書庫を新しく作って開く" />
                <Separator />
                <Button x:Name="ExtractButton" Content="展開"     Click="ExtractButton_Click" IsEnabled="False" ToolTip="選択した項目を展開する。選択していなければ書庫全体を展開する" />
                <Button x:Name="AddButton"     Content="追加"     Click="AddButton_Click"     IsEnabled="False" ToolTip="ファイルを書庫に追加する。一覧にドラッグしても追加できる" />
                <Separator />
                <!-- 追加時の圧縮の強さ (#11)。選んだ内容は設定に残る -->
                <TextBlock Text="圧縮" VerticalAlignment="Center" Margin="4,0,6,0" />
                <ComboBox x:Name="CompressionCombo"
                          Width="96"
                          DisplayMemberPath="Label"
                          SelectionChanged="CompressionCombo_SelectionChanged"
                          ToolTip="ファイルを追加するときの圧縮の強さ" />
                <Separator />
                <Button x:Name="RefreshButton" Content="更新"     Click="RefreshButton_Click" IsEnabled="False" ToolTip="書庫を読み直す" />
            </ToolBar>
        </ToolBarTray>

        <!-- アドレスバー: 書庫内の現在パスを表示する -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <DockPanel>
                <TextBlock Text="場所"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="AddressBar"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         Padding="4,2"
                         VerticalContentAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ステータスバー: 選択数 / 合計サイズ / 進捗 -->
        <StatusBar DockPanel.Dock="Bottom">
            <!-- 進捗と中断は右端に寄せるため、あえて先頭に記述している -->
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="ProgressIndicator"
                                 Width="150" Height="14"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                    <!-- 処理中だけ現れる (#37) -->
                    <Button x:Name="CancelButton"
                            Content="中断"
                            Click="CancelButton_Click"
                            Margin="8,0,0,0"
                            Padding="10,1"
                            Visibility="Collapsed" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusMessage" Text="書庫が開かれていません" />
            </StatusBarItem>
            <!-- パスが通常ではない項目を含む書庫を開いたときだけ出す (#36) -->
            <StatusBarItem x:Name="SuspiciousWarningItem" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE814;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center"
                               Margin="6,0,4,0" />
                    <TextBlock x:Name="SuspiciousWarningText"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="SelectionInfo" Text="選択 0 個" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="TotalSizeInfo" Text="合計 0 バイト" />
            </StatusBarItem>
        </StatusBar>

        <!-- 本体: 左にフォルダ階層、右にファイル一覧 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="240" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree"
                      Grid.Column="0"
                      BorderThickness="0"
                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type archives:ArchiveFolder}"
                                              ItemsSource="{Binding Folders}">
                        <StackPanel Orientation="Horizontal">
                            <!-- パスが通常ではないフォルダに警告を添える (#36) -->
                            <TextBlock Text="&#xE814;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"
                                       ToolTip="{StaticResource SuspiciousPathTooltip}"
                                       Visibility="{Binding IsPathSuspicious, Converter={StaticResource BoolToVisibility}}" />
                            <!-- 塗りつぶしのフォルダ。輪郭線のみだと書類と紛らわしい -->
                            <TextBlock Text="&#xE8D5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{StaticResource FolderBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{x:Static SystemColors.ControlBrush}"
                          ShowsPreview="False" />

            <Grid Grid.Column="2">
                <!--
                    数万ファイル規模の書庫でも固まらないよう、UI 仮想化を明示的に
                    有効化している (docs/SPEC.md 7章, #14)。
                -->
                <ListView x:Name="EntryList"
                          BorderThickness="0"
                          AllowDrop="True"
                          DragOver="EntryList_DragOver"
                          Drop="EntryList_Drop"
                          SelectionChanged="EntryList_SelectionChanged"
                          MouseDoubleClick="EntryList_MouseDoubleClick"
                          KeyDown="EntryList_KeyDown"
                          ContextMenuOpening="EntryList_ContextMenuOpening"
                          GridViewColumnHeader.Click="EntryList_ColumnHeaderClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.IsDeferredScrollingEnabled="False">
                    <!-- アプリ内のコンテキストメニュー。OSシェルへの統合はしない -->
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <!-- 一時フォルダへ取り出して既定のアプリに渡す (#12) -->
                            <MenuItem x:Name="OpenMenuItem"
                                      Header="開く"
                                      InputGestureText="Enter"
                                      FontWeight="Bold"
                                      Click="OpenMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="DeleteMenuItem"
                                      Header="削除"
                                      InputGestureText="Del"
                                      Click="DeleteMenuItem_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.Resources>
                        <!--
                            エクスプローラーに合わせて列見出しを左揃えにする。
                            既定では中央揃えになり、見た目が大きく異なる。
                        -->
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Padding" Value="6,2" />
                        </Style>
                        <!-- 数値列は見出しも値も右揃えにして桁を読みやすくする -->
                        <Style x:Key="NumericHeader" TargetType="GridViewColumnHeader"
                               BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                        </Style>

                        <DataTemplate x:Key="NameCell">
                            <StackPanel Orientation="Horizontal">
                                <!-- パスが通常ではない項目に警告を添える (#36) -->
                                <TextBlock Text="{Binding WarningGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{StaticResource WarningBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"
                                           ToolTip="{Binding WarningTooltip}"
                                           Visibility="{Binding IsPathSuspicious, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource FolderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="File">
                                                    <Setter Property="Foreground" Value="{StaticResource FileBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>

                        <DataTemplate x:Key="SizeCell">
                            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" MinWidth="80" />
                        </DataTemplate>
                        <DataTemplate x:Key="CompressedCell">
                            <TextBlock Text="{Binding CompressedText}" TextAlignment="Right" MinWidth="80" />
                        </DataTemplate>
                        <DataTemplate x:Key="RatioCell">
                            <TextBlock Text="{Binding RatioText}" TextAlignment="Right" MinWidth="50" />
                        </DataTemplate>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <!-- 既定のウィンドウ幅で5列が収まるようにしてある (合計700) -->
                            <GridViewColumn Header="名前"     Width="280" CellTemplate="{StaticResource NameCell}" />
                            <GridViewColumn Header="サイズ"   Width="100" CellTemplate="{StaticResource SizeCell}"
                                            HeaderContainerStyle="{StaticResource NumericHeader}" />
                            <GridViewColumn Header="圧縮後"   Width="100" CellTemplate="{StaticResource CompressedCell}"
                                            HeaderContainerStyle="{StaticResource NumericHeader}" />
                            <GridViewColumn Header="圧縮率"   Width="70"  CellTemplate="{StaticResource RatioCell}"
                                            HeaderContainerStyle="{StaticResource NumericHeader}" />
                            <GridViewColumn Header="更新日時" Width="150" DisplayMemberBinding="{Binding DateText}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 書庫が開かれていないときの案内。項目を表示したら隠す -->
                <TextBlock x:Name="EmptyStateMessage"
                           Text="書庫が開かれていません"
                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>

    </DockPanel>
</Window>
