<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      ダークテーマに使う ThemeMode は、まだ試験中の印 (WPF0001) が付いている (#122)。
      **抑えないとビルドが通らない。**版が上がったときに形が変わりうるので、
      .NET を上げたらここと App.xaml の ThemeMode を見直す。
    -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Expzip</AssemblyName>
    <RootNamespace>Expzip</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Expzip</Product>
    <Copyright>Copyright (c) 2026 P studio</Copyright>
    <!-- 画面の文言は日本語と英語を持つ (docs/SPEC.md 4.6節)。既定の言語はこちら -->
    <NeutralLanguage>ja-JP</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!--
      7z / tar の読み取りに使う (#19)。MITライセンスの純マネージド実装で、
      ネイティブDLLを持ち込まずに済む。ZIP は標準ライブラリのまま扱う。
    -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <!--
      パスワード付きZIPの読み書きに使う (#20)。MITライセンスの純マネージド実装で、
      WinZip AES (128/256) と旧方式の ZipCrypto の両方を扱える。
      暗号化されていない ZIP はこれまでどおり標準ライブラリで扱う。
    -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      分割した断片をつなぎ直す小さな Win32 実行ファイル (#59)。受け取った人が
      Expzip を持っていなくても元に戻せるよう、断片といっしょに書き出す。
      出来上がり (4.6KB) をリポジトリに置いてあるため、Expzip をビルドするのに
      C のツールチェーンは要らない。ソースとビルドし直す方法は tools/joiner にある。
    -->
    <EmbeddedResource Include="Resources\joiner-x86.exe" LogicalName="Expzip.Resources.joiner-x86.exe" />

    <!--
      自己解凍書庫の取り出し部 (#29)。この後ろに ZIP をそのまま繋いで配る。
      伸長器を内蔵しているため連結プログラムより大きいが、それでも 8.5KB。
      ソースとビルドし直す方法は tools/sfx にある。
    -->
    <EmbeddedResource Include="Resources\sfx-x86.exe" LogicalName="Expzip.Resources.sfx-x86.exe" />

    <!--
      配るものに入っているソフトウェアの、著作権表示と許諾条文 (#105)。

      **MIT は「上記の著作権表示とこの許諾条文を、複製物に含めること」を条件に
      している。**単一の実行ファイルとして配るので添付ファイルを並べる形は採れない。
      実行ファイルの中に入れ、バージョン情報から読めるようにすることで、
      どの複製にも必ず付いてくる。
    -->
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt"
                      LogicalName="Expzip.Resources.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!--
    表示と、実際に入れている版がずれていないか確かめる (#105)。

    **ずれても動いてしまうのが厄介なところ。**版を上げたときに表示を直し忘れると、
    入っていないものの表示を配ることになる。気付く手立てをここに置く。
  -->
  <Target Name="CheckNotices" BeforeTargets="Build">
    <PropertyGroup>
      <NoticesPath>$(MSBuildProjectDirectory)\..\..\THIRD-PARTY-NOTICES.txt</NoticesPath>
    </PropertyGroup>

    <Error Condition="!Exists('$(NoticesPath)')"
           Text="THIRD-PARTY-NOTICES.txt がありません。配るものに入れる表示なので、無いままではビルドできません (#105)" />

    <PropertyGroup>
      <NoticesText>$([System.IO.File]::ReadAllText('$(NoticesPath)'))</NoticesText>
    </PropertyGroup>

    <!-- 名前と版をつないだ「あるはずの一行」を作り、それが表示にあるかを見る -->
    <ItemGroup>
      <NoticeCheck Include="@(PackageReference)"
                   Condition="'%(Identity)' == 'SharpCompress' or '%(Identity)' == 'SharpZipLib'">
        <Wanted>%(Identity) %(Version)</Wanted>
      </NoticeCheck>
    </ItemGroup>

    <Error Condition="!$(NoticesText.Contains('%(NoticeCheck.Wanted)'))"
           Text="THIRD-PARTY-NOTICES.txt に「%(NoticeCheck.Wanted)」がありません。版を上げたら表示も直してください (#105)" />
  </Target>

  <!--
    ビルドしたときのコミットを組み込む (#104)。バージョン情報の窓に出す。
    版だけでは、同じ 0.1.0 のどれを渡したのかが分からない。

    **git が無くても、リポジトリの外に置いてもビルドできるようにする。**
    取れなければリビジョンは入らず、窓には「不明」と出る。
  -->
  <Target Name="StampRevision" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low"
          IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="RevisionHash" />
      <Output TaskParameter="ExitCode" PropertyName="RevisionExitCode" />
    </Exec>

    <!--
      そのコミットから手を入れた木でビルドしたかどうか。
      **黙って番号だけ出さない。**取り寄せても同じものにならないため、
      突き合わせる人が嘘の手掛かりを追うことになる
    -->
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; status --porcelain"
          ConsoleToMSBuild="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low"
          IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="RevisionChanges" />
    </Exec>

    <ItemGroup Condition="'$(RevisionExitCode)' == '0' and '$(RevisionHash)' != ''">
      <AssemblyMetadata Include="Revision" Value="$(RevisionHash.Trim())" />
      <AssemblyMetadata Include="RevisionModified"
                        Condition="'$(RevisionChanges)' != ''" Value="true" />
    </ItemGroup>
  </Target>

  <!--
    発行設定は Properties/PublishProfiles/win-x64.pubxml にある。
    ここに RuntimeIdentifier を書くと通常のビルドまで RID 固有になり
    開発時のビルドが遅くなるため、発行プロファイル側に分離している。
      dotnet publish src/Expzip -p:PublishProfile=win-x64
  -->

</Project>
