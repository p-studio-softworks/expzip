<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Expzip</AssemblyName>
    <RootNamespace>Expzip</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Expzip</Product>
    <Copyright>Copyright (c) 2026 P studio</Copyright>
    <!-- フェーズ1〜2は日本語UIのみ。多言語対応はフェーズ3 (docs/SPEC.md 8章) -->
    <NeutralLanguage>ja-JP</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!--
      7z / tar の読み取りに使う (#19)。MITライセンスの純マネージド実装で、
      ネイティブDLLを持ち込まずに済む。ZIP は標準ライブラリのまま扱う。
    -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <!--
      パスワード付きZIPの読み書きに使う (#20)。MITライセンスの純マネージド実装で、
      WinZip AES (128/256) と旧方式の ZipCrypto の両方を扱える。
      暗号化されていない ZIP はこれまでどおり標準ライブラリで扱う。
    -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      分割した断片をつなぎ直す小さな Win32 実行ファイル (#59)。受け取った人が
      Expzip を持っていなくても元に戻せるよう、断片といっしょに書き出す。
      出来上がり (4.6KB) をリポジトリに置いてあるため、Expzip を建てるのに
      C のツールチェーンは要らない。ソースと建て直し方は tools/joiner にある。
    -->
    <EmbeddedResource Include="Resources\joiner-x86.exe" LogicalName="Expzip.Resources.joiner-x86.exe" />

    <!--
      自己解凍書庫の取り出し部 (#29)。この後ろに ZIP をそのまま繋いで配る。
      伸長器を内蔵しているため連結プログラムより大きいが、それでも 8.5KB。
      ソースと建て直し方は tools/sfx にある。
    -->
    <EmbeddedResource Include="Resources\sfx-x86.exe" LogicalName="Expzip.Resources.sfx-x86.exe" />
  </ItemGroup>

  <!--
    発行設定は Properties/PublishProfiles/win-x64.pubxml にある。
    ここに RuntimeIdentifier を書くと通常のビルドまで RID 固有になり
    開発時のビルドが遅くなるため、発行プロファイル側に分離している。
      dotnet publish src/Expzip -p:PublishProfile=win-x64
  -->

</Project>
