<?xml version="1.0" encoding="utf-8"?>
<!--
  インストール不要のポータブル配布用の発行プロファイル (docs/SPEC.md 3章)。

    dotnet publish src/Expzip -p:PublishProfile=win-x64

  出力された Expzip.exe を単体でコピーすれば動作する。
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\win-x64\</PublishDir>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
      アセンブリも全部、起動したときに %TEMP%\.net\Expzip\<印> へ取り出して使う (#305)。
      exe に入れたままだと、.NET はアセンブリの隣、つまり exe の隣で Windows の DLL
      (kernel32.dll など) を場所付きで探す。ダウンロードフォルダーに同じ名前の DLL を
      置かれると、Expzip のコードが動く前にそれが読み込まれる。取り出しておけば、
      アセンブリの隣は Expzip 専用の一時フォルダーになる。
      一時フォルダーに 160 MB ほど置く (ReadyToRun (#398) で、#305 のときの 127 MB から増えた)。
      #305 のときは、初回の起動は 0.3 秒ほど遅く、2 回目からは 0.1 秒ほど速くなった。
      古いバージョンの分は OldExtraction が消す
    -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!--
      PublishTrimmed は WPF では非サポート。XAML がリフレクションに依存しており、
      トリミングすると実行時に落ちる。exe サイズは 70〜100MB 程度になるが、
      自己完結型配布のコストとして許容する (docs/SPEC.md 3章)。
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      Expzip、Expzip.Core と、使っているライブラリを、発行するときに機械語にしておく (#398)。
      .NET と WPF の部品は元から機械語になっているが、こちらは起動のたびにコンパイルしていて、
      画面が出るまでの約 520 ms のうち 80 ms ほどがそれだった。exe は約 9 MB 大きくなり、
      取り出す量が増えるので、初めての起動は約 0.2 秒遅くなる。
      機械語にするツール (crossgen) はビルドする PC で動くので、Expzip.csproj の CheckCrossgenPin が、
      crossgen を動かす前に指紋を確かめる
    -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- 埋め込むアセンブリを圧縮して exe サイズを削減する -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
