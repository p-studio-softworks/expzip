<Application x:Class="Expzip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Expzip"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!--
            重さを表す色。一覧 (#36、#20) と検査結果の画面 (#57) の両方から使うため、
            アプリ全体の資源に置いてある。同じ意味の色が窓ごとに違うと、
            利用者はそれぞれ別の意味だと受け取る
        -->
        <SolidColorBrush x:Key="WarningBrush" Color="#C42B1C" />
        <!-- 危険と問題なしの間。赤ほど強くなく、灰色よりは目に入る -->
        <SolidColorBrush x:Key="CautionBrush" Color="#9D5D00" />
        <!--
            パスワードで保護された項目の色 (#20)。保護されていることは色で示す。
            緑にするのは、エクスプローラーが EFS で暗号化されたファイルを緑で出す
            習わしに倣ったもの。色そのものは合わせていない (あちらの既定は #008000
            あたりの深緑)。
            検査結果の「問題なし」(#57)、ルールの検査結果の見出し (#27)、
            AI の接続先の「つながりました」にも同じ緑を使う。
            **この 1 箇所で決める。窓ごとに数値を書かない** (#120)。

            白地だけでなく、行を選んだときの薄い青と、ルールに合っていない行の
            薄い赤の上でも本文に要る 4.5 : 1 を満たす明るさにしてある (#120)。
            明るくすると、選んだ行で読めなくなる
        -->
        <SolidColorBrush x:Key="EncryptedBrush" Color="#0B5D0B" />
        <!--
            保存した決まりに合っていない項目の色 (#27)。
            危険を表す赤とは別の色にする。決まりから外れていることは危ないことではなく、
            「取り決めと違う」というだけ。同じ色にすると、中身が怪しい書庫と、
            名前の付け方が違うだけの書庫が同じ顔になる
        -->
        <SolidColorBrush x:Key="RuleBreakBrush" Color="#6B4FBB" />
        <!--
            ツリーで印を付けるときの地色 (#88)。旗を前に置くと、その1文字ぶん
            名前がずれ、**兄弟のフォルダと段が違って見える。**ツリーは段で親子を
            読ませる絵なので、そこを狂わせてはいけない。地色なら幅が変わらない。
            薄い赤にしてあるのは、黒い文字を白地と同じに読ませたまま、
            目には入るようにするため
        -->
        <SolidColorBrush x:Key="RuleBreakBackBrush" Color="#F6BFBA" />
    </Application.Resources>
</Application>
