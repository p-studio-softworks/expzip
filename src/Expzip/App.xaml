<Application x:Class="Expzip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Expzip"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ThemeMode="System"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                列のある一覧の行の最小の高さ。行の間隔をエクスプローラーに合わせる (#125)。
                Fluent のままでは 1.5 倍ほど広い。エクスプローラーと同じ表示倍率で実際の行を測り、
                同じ間隔になる値にしてある (表示倍率 150% で 43 px)。ツリーは元から揃っている。
                **どの一覧もこの 1 つを使う** (#131)。ウィンドウごとに数値を書くと、
                メインの一覧だけ詰めてほかが広いまま残る
            -->
            <sys:Double x:Key="ListRowMinHeight">27</sys:Double>

            <!--
                意味を表す色は、**明るい背景用と暗い背景用を組で持つ** (#122)。
                どちらを使うかは Theme が背景色の明るさを見て決める。

                背景色の明るさが変われば、同じ色は読めなくなる。ただし
                **ハイコントラストでは組を増やさない** (#121)。あちらは背景色の
                明るさが場所ごとに混ざるため、2組を持つと同じ意味の色が8つ
                同時に見えうる。テーマが揃った画面では背景色の明るさが
                アプリ全体で1つに決まるので、**画面に出るのは常に4色**になる。

                暗いほうの値は WinUI が用意している対から採っている
                (`SystemFillColorSuccess` / `Caution` / `Critical` の暗いほう)。
                明るいほうの注意の橙と危険の赤は、**WinUI の値と元から同じ**。

                比はすべて実測。本文に要る 4.5 : 1 は、ウィンドウの背景色だけでなく
                **選んだ行の背景色の上でも満たす** (#120)。

                ハイコントラストでは、この4色は**付けない**。背景色がそのとき次第で
                組にできないため (#121、理由は Theme.cs にある)。
            -->
            <ResourceDictionary x:Key="LightColors">
                <!--
                    危険を表す色。一覧 (#36、#20) と検査結果の画面 (#57) の両方から
                    使うため、アプリ全体の資源に置いてある。同じ意味の色がウィンドウごとに
                    違うと、利用者はそれぞれ別の意味だと受け取る。
                    ウィンドウの背景色 5.10 : 1 / 選んだ行 4.71 : 1
                -->
                <SolidColorBrush x:Key="WarningBrush" Color="#C42B1C" />
                <!--
                    危険と問題なしの間。赤ほど強くなく、灰色よりは目に入る。
                    ウィンドウの背景色 4.73 : 1 / 選んだ行 4.36 : 1。
                    **選んだ行では 4.5 : 1 にわずかに届かない。**濃くすれば届くが、
                    そうすると赤との差が縮み、重さの違いが読み取れなくなる。
                    意味は言葉でも出してある (#119)
                -->
                <SolidColorBrush x:Key="CautionBrush" Color="#9D5D00" />
                <!--
                    パスワードで保護された項目の色 (#20)。保護されていることは色で示す。
                    緑にするのは、エクスプローラーが EFS で暗号化されたファイルを緑で出す
                    習わしに倣ったもの。色そのものは合わせていない (あちらのデフォルトは #008000
                    あたりの深緑)。
                    検査結果の「問題なし」(#57)、ルールの検査結果の見出し (#27)、
                    AI の接続先の「つながりました」にも同じ緑を使う。
                    **この 1 箇所で決める。ウィンドウごとに数値を書かない** (#120)。
                    ウィンドウの背景色 7.32 : 1 / 選んだ行 6.75 : 1 / ルールに合っていない背景色 4.95 : 1
                -->
                <SolidColorBrush x:Key="EncryptedBrush" Color="#0B5D0B" />
                <!--
                    保存した決まりに合っていない項目の色 (#27)。
                    危険を表す赤とは別の色にする。決まりから外れていることは危ないことではなく、
                    「取り決めと違う」というだけ。同じ色にすると、中身が怪しい書庫と、
                    名前の付け方が違うだけの書庫が同じ顔になる。
                    ウィンドウの背景色 5.47 : 1 / 選んだ行 5.04 : 1
                -->
                <SolidColorBrush x:Key="RuleBreakBrush" Color="#6B4FBB" />
                <!--
                    ツリーで印を付けるときの背景色 (#88)。旗を前に置くと、その1文字ぶん
                    名前がずれ、**兄弟のフォルダと段が違って見える。**ツリーは段で親子を
                    読ませる絵なので、そこを狂わせてはいけない。背景色なら幅が変わらない。
                    薄い赤にしてあるのは、黒い文字を白い背景と同じに読ませたまま、
                    目には入るようにするため。
                    **背景色と文字は組で決める** (#121)。背景色だけ決めて文字色を Windows から
                    採ると、背景色の明るさが変わったときに読めなくなる。

                    **色覚特性でも背景と見分けられる色にしてある** (#119)。1 型・2 型・3 型の
                    どれでも、ウィンドウの背景・選んだ行との色の差 (ΔE) が 22.7 以上ある。
                    上に乗る黒は 12.80 : 1、保護の緑は 4.95 : 1。
                    前の #F6BFBA は 1 型・2 型で 15 まで落ちていた (目安は 20)。
                    明るくすると文字が読みにくくなり、暗くすると背景と見分けにくくなるので、
                    **色を変えるときは両方を測る。**測り方は仕様書 4.9 節
                -->
                <SolidColorBrush x:Key="RuleBreakBackBrush" Color="#FFBAA3" />
                <SolidColorBrush x:Key="RuleBreakTextBrush" Color="#000000" />
                <!--
                    アドレスバーで指している場所 (#90、#121)。ここも背景色と文字を組で決める。
                    一覧の選んだ行と同じ灰色 (#130)
                -->
                <SolidColorBrush x:Key="HoverBackBrush" Color="#EAEAEA" />
                <SolidColorBrush x:Key="HoverTextBrush" Color="#000000" />
                <!--
                    選んだ行とマウスが乗った行の背景色 (#130)。ツリーも一覧も同じ色にする。
                    **薄い青にはしない。**エクスプローラーの選択は灰色で、青にすると
                    エクスプローラーライクでなくなる。
                    明るい表示は Fluent と同じ灰色のまま。**これより濃くできない。**
                    危険の赤が 4.71 : 1、注意の色が 4.36 : 1 で、もう余裕が無い。
                    それでも書くのは、暗い表示から切り替えたときに暗いほうの色を上書きするため
                -->
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#EAEAEA" />
                <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#EAEAEA" />
                <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#EAEAEA" />
            </ResourceDictionary>

            <!--
                背景色が暗いときの組 (#122)。比はウィンドウの背景色 `#202020` と
                選んだ行の背景色 `#404040` (#130) に対する実測。
            -->
            <ResourceDictionary x:Key="DarkColors">
                <!-- ウィンドウの背景色 8.03 : 1 / 選んだ行 5.11 : 1 -->
                <SolidColorBrush x:Key="WarningBrush" Color="#FF99A4" />
                <!-- ウィンドウの背景色 12.34 : 1 / 選んだ行 7.85 : 1 -->
                <SolidColorBrush x:Key="CautionBrush" Color="#FCE100" />
                <!-- ウィンドウの背景色 8.03 : 1 / 選んだ行 5.11 : 1 -->
                <SolidColorBrush x:Key="EncryptedBrush" Color="#6CCB5F" />
                <!--
                    WinUI にルールに合っていないことを表す色は無いので、
                    ここだけこちらで決めた。ウィンドウの背景色 7.42 : 1 / 選んだ行 4.72 : 1
                -->
                <SolidColorBrush x:Key="RuleBreakBrush" Color="#B9A3F0" />
                <!--
                    ルールに合っていない印。明るいほうと同じく、**背景色と文字を組で持つ。**
                    白い文字が 12.26 : 1。この背景色の上でも4色すべてが 5.58 : 1 以上ある。
                    色覚特性でも、1 型・2 型・3 型のどれでもウィンドウの背景・選んだ行との
                    色の差 (ΔE) が 25.3 以上ある (#119)。前の #5A2E2A は 1 型で 9 まで落ちていた
                -->
                <SolidColorBrush x:Key="RuleBreakBackBrush" Color="#661A00" />
                <SolidColorBrush x:Key="RuleBreakTextBrush" Color="#FFFFFF" />
                <!-- アドレスバーで指している場所。一覧の選んだ行と同じ灰色。白い文字で 10.37 : 1 -->
                <SolidColorBrush x:Key="HoverBackBrush" Color="#404040" />
                <SolidColorBrush x:Key="HoverTextBrush" Color="#FFFFFF" />
                <!--
                    選んだ行とマウスが乗った行 (#130)。Fluent のままの #2D2D2D では、
                    ウィンドウの背景色との差が 1.18 : 1 しかなく、どの行を選んだか見えにくい。
                    **意味を表す4色が 4.5 : 1 を保てる、いちばん明るい灰色**にしてある
                    (ルールに合っていない紫が 4.72 : 1)。ウィンドウの背景色との差は 1.57 : 1。
                    エクスプローラーは #505050 まで明るいが、そこまで上げると紫と緑が 4 : 1 を割る
                -->
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#404040" />
                <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#404040" />
                <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#404040" />
            </ResourceDictionary>
        </ResourceDictionary>
    </Application.Resources>
</Application>
