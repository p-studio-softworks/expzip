<Window x:Class="Expzip.Ui.RuleLearnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1040"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        お手本書庫からルールを学び、人が確かめて直す (#25、#26)。
        送る前に、送るものをそのまま見せる。
        文言はすべて ApplyLanguage が入れる (#23)
    -->
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock x:Name="SendLabel" FontWeight="SemiBold" Margin="0,0,0,4" />

        <!--
            外へ出す前に、出すものをそのまま置く。畳んだ要約ではなく現物を見せる。
            等幅にするのは、フォルダの深さが揃って見えるため
        -->
        <TextBox x:Name="PayloadBox" Height="150" IsReadOnly="True"
                 FontFamily="Consolas, MS Gothic" FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />

        <TextBlock x:Name="PayloadText" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{x:Static SystemColors.GrayTextBrush}" />

        <TextBlock x:Name="ResultText" Margin="0,12,0,0" TextWrapping="Wrap" />

        <!-- 読み取れた決まり。1件も無いうちは場所を取らない -->
        <ListView x:Name="RuleList" Height="220" Margin="0,8,0,0"
                  Visibility="Collapsed"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <!--
                行の名前。入れておかないと、支援技術には束ねている型の名前が
                そのまま読まれる
            -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding Description}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <!-- 外した決まりは、保存しても当てない -->
                    <GridViewColumn x:Name="UseColumn" Width="48">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="KindColumn" Width="110"
                                    DisplayMemberBinding="{Binding KindText}" />
                    <GridViewColumn x:Name="ScopeColumn" Width="110"
                                    DisplayMemberBinding="{Binding ScopeText}" />
                    <GridViewColumn x:Name="ValueColumn" Width="140"
                                    DisplayMemberBinding="{Binding Value}" />
                    <GridViewColumn x:Name="DescriptionColumn" Width="220"
                                    DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn x:Name="EvidenceColumn" Width="170"
                                    DisplayMemberBinding="{Binding Evidence}" />
                    <GridViewColumn x:Name="SourceColumn" Width="70"
                                    DisplayMemberBinding="{Binding SourceText}" />
                    <!-- いま開いている書庫に当てるとどうなるか (#26) -->
                    <GridViewColumn x:Name="VerdictColumn" Width="110"
                                    DisplayMemberBinding="{Binding Verdict}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 提案であって確かめた結果ではない、と断る (仕様書 11.5節) -->
        <TextBlock x:Name="NoticeText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{x:Static SystemColors.GrayTextBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SendButton" Width="160" Height="26" Margin="0,0,8,0"
                    IsDefault="True" Click="SendButton_Click" />
            <Button x:Name="SaveButton" Width="120" Height="26" Margin="0,0,8,0"
                    Click="SaveButton_Click" />
            <Button x:Name="CloseButton" Width="96" Height="26"
                    IsCancel="True" Click="CloseButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
