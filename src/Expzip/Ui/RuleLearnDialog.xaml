<Window x:Class="Expzip.Ui.RuleLearnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Expzip.Ui"
        Width="1040"
        Height="620"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!--
            幅の決まっている列: 使う 48 + 種類 110 + 対象 110 + 出どころ 70
            + この書庫では 110 = 448。縦スクロール棒と余白で 40 を見込む。
            残りを 場所 22 : 値 24 : 説明 32 : 根拠 22 で分ける (#77、#81)
        -->
        <ui:ShareWidth x:Key="Share" Fixed="488" />
    </Window.Resources>

    <!--
        お手本書庫からルールを学び、人が確かめて直す (#25、#26)。
        送る前に、送るものをそのまま見せる。
        文言はすべて ApplyLanguage が入れる (#23)
    -->

    <!--
        書庫詳細とルール一覧は、どちらも中身の量が書庫によって大きく変わる。
        窓を広げた分だけ伸びるように、StackPanel ではなく Grid で組む (#75)
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 書庫詳細。送る前はここだけが伸びる -->
            <RowDefinition x:Name="PayloadRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!--
                ルール一覧。読み取る前は 1件も無いので高さ 0 にしておく。
                Collapsed にしても * のままでは場所を取り続けてしまうため、
                ShowRows で高さも入れ替える
            -->
            <RowDefinition x:Name="RuleRow" Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock x:Name="SendLabel" Grid.Row="1" FontWeight="SemiBold" Margin="0,0,0,4" />

        <!--
            外へ出す前に、出すものをそのまま置く。畳んだ要約ではなく現物を見せる。
            等幅にするのは、フォルダの深さが揃って見えるため
        -->
        <TextBox x:Name="PayloadBox" Grid.Row="2" MinHeight="120" IsReadOnly="True"
                 FontFamily="Consolas, MS Gothic" FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />

        <TextBlock x:Name="PayloadText" Grid.Row="3" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{x:Static SystemColors.GrayTextBrush}" />

        <TextBlock x:Name="ResultText" Grid.Row="4" Margin="0,12,0,0" TextWrapping="Wrap" />

        <!-- 読み取れたルール。1件も無いうちは場所を取らない -->
        <ListView x:Name="RuleList" Grid.Row="5" MinHeight="160" Margin="0,8,0,0"
                  Visibility="Collapsed"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  GridViewColumnHeader.Click="Header_Click"
                  SelectionMode="Extended"
                  SelectionChanged="RuleList_SelectionChanged"
                  KeyDown="RuleList_KeyDown">
            <!--
                行の名前。入れておかないと、支援技術には束ねている型の名前が
                そのまま読まれる
            -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding Description}" />
                    <!--
                        採らなかった候補は薄く出す (#80)。見せはするが、
                        使えるものと同じ顔で並べると取り違える
                    -->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanUse}" Value="False">
                            <Setter Property="Foreground"
                                    Value="{x:Static SystemColors.GrayTextBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <!-- 外したルールは、保存しても当てない -->
                    <GridViewColumn x:Name="UseColumn" Width="48">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 採らなかった候補は選べない (#80) -->
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          IsEnabled="{Binding CanUse}"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="KindColumn" Width="110"
                                    DisplayMemberBinding="{Binding KindText}" />
                    <GridViewColumn x:Name="ScopeColumn" Width="110"
                                    DisplayMemberBinding="{Binding ScopeText}" />
                    <!-- 当てる場所 (#81)。中身は正規表現なので、幅を分け合う側に置く -->
                    <GridViewColumn x:Name="PlaceColumn"
                                    Width="{Binding ActualWidth, ElementName=RuleList,
                                                    Converter={StaticResource Share},
                                                    ConverterParameter=0.22}"
                                    DisplayMemberBinding="{Binding WhereText}" />
                    <!--
                        値・説明・根拠は中身が長い。**ここが読めないと質を判断
                        できない**ので、窓を広げた分は3つで分け合う (#77)
                    -->
                    <GridViewColumn x:Name="ValueColumn"
                                    Width="{Binding ActualWidth, ElementName=RuleList,
                                                    Converter={StaticResource Share},
                                                    ConverterParameter=0.24}"
                                    DisplayMemberBinding="{Binding Value}" />
                    <GridViewColumn x:Name="DescriptionColumn"
                                    Width="{Binding ActualWidth, ElementName=RuleList,
                                                    Converter={StaticResource Share},
                                                    ConverterParameter=0.32}"
                                    DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn x:Name="EvidenceColumn"
                                    Width="{Binding ActualWidth, ElementName=RuleList,
                                                    Converter={StaticResource Share},
                                                    ConverterParameter=0.22}"
                                    DisplayMemberBinding="{Binding Evidence}" />
                    <GridViewColumn x:Name="SourceColumn" Width="70"
                                    DisplayMemberBinding="{Binding SourceText}" />
                    <!-- いま開いている書庫に当てるとどうなるか (#26) -->
                    <GridViewColumn x:Name="VerdictColumn" Width="110"
                                    DisplayMemberBinding="{Binding Verdict}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 提案であって確かめた結果ではない、と断る (仕様書 11.5節) -->
        <TextBlock x:Name="NoticeText" Grid.Row="6" Margin="0,10,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{x:Static SystemColors.GrayTextBrush}" />

        <StackPanel Grid.Row="7" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SendButton" Width="160" Height="26" Margin="0,0,8,0"
                    IsDefault="True" Click="SendButton_Click" />
            <!--
                選んだものを一覧から消す (#98)。推定するたびに増える一方だった。
                足す・直す (#72 で外した) と違い、**新しい決まりを作らせない**ので、
                誤ったものが生まれる余地が無い。保存するまでファイルは変わらない
            -->
            <!--
                押せないときこそ訳が要る (#101)。既定では押せないボタンの説明は
                出ないので、出す指定を入れておく
            -->
            <Button x:Name="DeleteButton" MinWidth="140" Padding="10,0" Height="26" Margin="0,0,8,0"
                    IsEnabled="False"
                    ToolTipService.ShowOnDisabled="True"
                    Click="DeleteButton_Click" />
            <Button x:Name="SaveButton" Width="120" Height="26" Margin="0,0,8,0"
                    Click="SaveButton_Click" />
            <Button x:Name="CloseButton" Width="96" Height="26"
                    IsCancel="True" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
