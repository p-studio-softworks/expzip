<Window x:Class="Expzip.Ui.RuleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        決まりを1つ入れる・直す (#26)。直しながら、その決まりを
        いま開いている書庫に当てた結果をその場に出す。
        文言はすべて ApplyLanguage が入れる (#23)
    -->
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="KindLabel" Grid.Row="0" Grid.Column="0"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="KindCombo" Grid.Row="0" Grid.Column="1"
                      SelectionChanged="Input_Changed" />

            <TextBlock x:Name="ScopeLabel" Grid.Row="1" Grid.Column="0"
                       VerticalAlignment="Center" Margin="0,10,10,0" />
            <ComboBox x:Name="ScopeCombo" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                      SelectionChanged="Input_Changed" />

            <TextBlock x:Name="ValueLabel" Grid.Row="2" Grid.Column="0"
                       VerticalAlignment="Center" Margin="0,10,10,0" />
            <TextBox x:Name="ValueBox" Grid.Row="2" Grid.Column="1"
                     Margin="0,10,0,0" Padding="4,3"
                     VerticalContentAlignment="Center" TextChanged="Input_Changed" />

            <TextBlock x:Name="DescriptionLabel" Grid.Row="3" Grid.Column="0"
                       VerticalAlignment="Center" Margin="0,10,10,0" />
            <TextBox x:Name="DescriptionBox" Grid.Row="3" Grid.Column="1"
                     Margin="0,10,0,0" Padding="4,3"
                     VerticalContentAlignment="Center" TextChanged="Input_Changed" />
        </Grid>

        <!-- 値が何を指すかは種類で変わる。その場で言い換える -->
        <TextBlock x:Name="HintText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{x:Static SystemColors.GrayTextBrush}" />

        <!-- いま開いている書庫に当てた結果。直すそばから出す -->
        <TextBlock x:Name="VerdictText" Margin="0,12,0,0" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Width="96" Height="26" Margin="0,0,8,0"
                    IsDefault="True" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Width="96" Height="26"
                    IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
