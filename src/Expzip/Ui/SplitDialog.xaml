<Window x:Class="Expzip.Ui.SplitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        ファイルの分割 (#59)。設定は3つだけにする。
        連結方法の選択肢は出さない。文言はすべて ApplyLanguage が入れる (#23)
    -->
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="SourceLabel" Grid.Row="0" Grid.Column="0"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="SourceBox" Grid.Row="0" Grid.Column="1"
                     Padding="4,3" VerticalContentAlignment="Center"
                     TextChanged="Input_Changed" />
            <Button x:Name="BrowseSourceButton" Grid.Row="0" Grid.Column="2"
                    Width="72" Height="26" Margin="8,0,0,0"
                    Click="BrowseSourceButton_Click" />

            <TextBlock x:Name="DestinationLabel" Grid.Row="1" Grid.Column="0"
                       VerticalAlignment="Center" Margin="0,10,10,0" />
            <TextBox x:Name="DestinationBox" Grid.Row="1" Grid.Column="1"
                     Padding="4,3" Margin="0,10,0,0" VerticalContentAlignment="Center"
                     TextChanged="Input_Changed" />
            <Button x:Name="BrowseDestinationButton" Grid.Row="1" Grid.Column="2"
                    Width="72" Height="26" Margin="8,10,0,0"
                    Click="BrowseDestinationButton_Click" />

            <TextBlock x:Name="SizeLabel" Grid.Row="2" Grid.Column="0"
                       VerticalAlignment="Center" Margin="0,10,10,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBox x:Name="SizeBox" Width="110"
                         Padding="4,3" TextAlignment="Right"
                         VerticalContentAlignment="Center"
                         TextChanged="Input_Changed" />
                <ComboBox x:Name="UnitCombo" Width="72" Margin="8,0,0,0"
                          SelectionChanged="Unit_Changed" />
            </StackPanel>
        </Grid>

        <!-- いまの設定だと何個になるか。押す前に分かるようにする -->
        <TextBlock x:Name="PreviewText"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Foreground="{x:Static SystemColors.GrayTextBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SplitButton" Width="96" Height="26" Margin="0,0,8,0"
                    IsDefault="True" Click="SplitButton_Click" />
            <Button x:Name="CancelButton" Width="96" Height="26"
                    IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
