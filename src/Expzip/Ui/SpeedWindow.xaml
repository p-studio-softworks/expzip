<Window x:Class="Expzip.Ui.SpeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Expzip"
        Width="1160" Height="760"
        MinWidth="600" MinHeight="460"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        処理時間の見積もり (#269)。上に進み具合、真ん中に測る場所と結果、下にコピーと閉じる。
        文言はすべて ApplyLanguage が入れる。XAML には書かない (#23)
    -->
    <DockPanel>

        <!-- 帯の背景色はハッシュ値の画面と同じ (#121) -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock x:Name="Headline"
                       Margin="16,12"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,10,16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyButton"
                        MinWidth="96"
                        IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        Click="CopyButton_Click" />
                <!-- 測定の途中で閉じると中断する -->
                <Button x:Name="CloseButton"
                        MinWidth="96"
                        Margin="8,0,0,0"
                        IsCancel="True"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,0">
                <TextBlock x:Name="Intro" TextWrapping="Wrap" />

                <!--
                    測る場所。一時フォルダーか、利用者が選んだフォルダー。
                    外付けのディスクや NAS で作業したいことがあるため
                -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PlaceLabel"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <RadioButton x:Name="TempChoice"
                                 Grid.Column="1"
                                 GroupName="Place"
                                 IsChecked="True"
                                 Checked="Place_Checked" />
                    <RadioButton x:Name="FolderChoice"
                                 Grid.Row="1" Grid.Column="1"
                                 GroupName="Place"
                                 Checked="Place_Checked" />
                    <Button x:Name="BrowseButton"
                            Grid.Row="1" Grid.Column="2"
                            MinWidth="96"
                            Margin="12,0,0,0"
                            Click="BrowseButton_Click" />
                </Grid>

                <Button x:Name="StartButton"
                        HorizontalAlignment="Left"
                        MinWidth="120"
                        Margin="0,12,0,0"
                        IsDefault="True"
                        Click="StartButton_Click" />

                <!--
                    進み具合。押したボタンのすぐ下に横幅いっぱいで出す。
                    見出しの帯の端に小さく置いていたときは目に入らなかった
                -->
                <ProgressBar x:Name="MeasureProgress"
                             Height="8"
                             Margin="0,12,0,0"
                             Visibility="Collapsed" />

                <!-- 結果。測っていなければ出さない -->
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <ListView x:Name="EstimateList"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                              SelectionMode="Extended">
                        <ListView.ItemContainerStyle>
                            <!-- 列のある一覧なので、Fluent のデフォルトはこちらを継承する (#122) -->
                            <Style TargetType="ListViewItem"
                                   BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                                <!-- 入れておかないと、支援技術には束ねている型の名前が読まれる (#109) -->
                                <Setter Property="AutomationProperties.Name"
                                        Value="{Binding RowName}" />
                                <!-- 行の間隔はメインの一覧と同じ (#131、値は App.xaml) -->
                                <Setter Property="MinHeight" Value="{StaticResource ListRowMinHeight}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Resources>
                            <!-- 本体の一覧と同じく、列見出しは左揃えにする -->
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Padding" Value="6,2" />
                            </Style>

                            <!--
                                評価の色 (1 分未満は緑、10 分未満は黄、それより長いと赤)。
                                色は意味を表す 4 色の組から採る (#119、仕様書 4.9節)。
                                付けるのは、こちらで色を決めてよいときだけ (#121)。ハイコントラストでは
                                行を選ぶと背景色が Windows の選択色に変わり、こちらで決めた色は組にならない。
                                評価は字でも出し、分け方は表の下に書いてある。色だけでは伝えない
                            -->
                            <Style x:Key="AccentRun" TargetType="Run">
                                <Style.Triggers>
                                    <!-- **色は名前で選ぶ (#122)。**テーマが切り替わったとき前の色のまま残らないように -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Source={x:Static local:Theme.Instance}, Path=UseAccentColors}"
                                                       Value="True" />
                                            <Condition Binding="{Binding AccentKey}" Value="EncryptedBrush" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{DynamicResource EncryptedBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Source={x:Static local:Theme.Instance}, Path=UseAccentColors}"
                                                       Value="True" />
                                            <Condition Binding="{Binding AccentKey}" Value="CautionBrush" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Source={x:Static local:Theme.Instance}, Path=UseAccentColors}"
                                                       Value="True" />
                                            <Condition Binding="{Binding AccentKey}" Value="WarningBrush" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>

                            <!--
                                1 マス。色を付けるのは時間だけで、「圧縮」「展開」は付けない。
                                並べた Run の間の改行は空白 1 つになる
                            -->
                            <DataTemplate x:Key="TimeCell">
                                <TextBlock>
                                    <Run Text="{Binding CompressLabel, Mode=OneWay}" />
                                    <Run DataContext="{Binding Compress}" Text="{Binding Text, Mode=OneWay}"
                                         Style="{StaticResource AccentRun}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding ExtractLabel, Mode=OneWay}" />
                                    <Run DataContext="{Binding Extract}" Text="{Binding Text, Mode=OneWay}"
                                         Style="{StaticResource AccentRun}" />
                                </TextBlock>
                            </DataTemplate>
                            <DataTemplate x:Key="DocumentsCell">
                                <ContentPresenter Content="{Binding Documents}"
                                                  ContentTemplate="{StaticResource TimeCell}" />
                            </DataTemplate>
                            <DataTemplate x:Key="MediaCell">
                                <ContentPresenter Content="{Binding Media}"
                                                  ContentTemplate="{StaticResource TimeCell}" />
                            </DataTemplate>
                            <DataTemplate x:Key="SmallFilesCell">
                                <ContentPresenter Content="{Binding SmallFiles}"
                                                  ContentTemplate="{StaticResource TimeCell}" />
                            </DataTemplate>
                            <DataTemplate x:Key="RatingCell">
                                <TextBlock>
                                    <Run DataContext="{Binding Rating}" Text="{Binding Text, Mode=OneWay}"
                                         Style="{StaticResource AccentRun}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListView.Resources>
                        <ListView.View>
                            <!-- 「圧縮 12 時間 30 分 / 展開 15 時間 45 分」が収まる幅 -->
                            <GridView>
                                <GridViewColumn x:Name="SizeColumn" Width="100"
                                                DisplayMemberBinding="{Binding Size}" />
                                <GridViewColumn x:Name="DocumentsColumn" Width="290"
                                                CellTemplate="{StaticResource DocumentsCell}" />
                                <GridViewColumn x:Name="MediaColumn" Width="290"
                                                CellTemplate="{StaticResource MediaCell}" />
                                <GridViewColumn x:Name="SmallFilesColumn" Width="290"
                                                CellTemplate="{StaticResource SmallFilesCell}" />
                                <GridViewColumn x:Name="RatingColumn" Width="110"
                                                CellTemplate="{StaticResource RatingCell}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock x:Name="Note"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBlock x:Name="ConditionsLabel"
                               Margin="0,16,0,4"
                               FontWeight="SemiBold" />
                    <!-- 別のパソコンの結果と比べるとき、何が違うかを読み取れるように -->
                    <TextBlock x:Name="Conditions"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
