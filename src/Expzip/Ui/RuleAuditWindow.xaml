<Window x:Class="Expzip.Ui.RuleAuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Expzip"
        Width="920" Height="560"
        MinWidth="520" MinHeight="320"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        決まりに合っているかの結果 (#27)。上に要約、下に「種類 / 対象 / 決まり」の一覧。
        検査結果の窓 (#57) と同じ作りにしてある。別窓にして、開いたまま一覧を
        触れるようにする。行を選ぶと本体側でその項目に飛ぶ。
        文言はすべて ApplyLanguage が入れる (#23)
    -->
    <DockPanel>

        <!-- 帯の地は ControlBrush にする (#121)。検査結果の窓と同じ理由 -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Margin="16,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HeadlineGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="Headline"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- どの決まりを、いつ、どの書庫から作ったものを当てたか -->
                <TextBlock x:Name="SourceLine"
                           Margin="24,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <!-- 多すぎて出し切れなかったときだけ出す -->
                <TextBlock x:Name="TrimmedLine"
                           Margin="24,6,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource CautionBrush}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,10,16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!--
                    直したら押す (#87)。押すと**検査し直す。**
                    直っていれば印が消え、直っていなければそう言う。
                    名前は「更新」(#88)。することは書庫の読み直しで、
                    何が起きるかは説明で添える
                -->
                <Button x:Name="DoneButton"
                        Width="96" Height="26" Margin="0,0,8,0"
                        Click="DoneButton_Click" />
                <Button x:Name="CloseButton"
                        Width="96" Height="26"
                        IsCancel="True"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Border>

        <!-- 行を選ぶと、本体側でその項目に飛ぶ -->
        <ListView x:Name="FindingList"
                  BorderThickness="0"
                  SelectionMode="Single"
                  SelectionChanged="FindingList_SelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <!--
                行の名前。入れておかないと、支援技術には束ねている型の名前が
                そのまま読まれる。検査結果の一覧と同じく、種類・対象・内容を
                この順に読む (#109)
            -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding RowName}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="6,2" />
                </Style>

                <!-- 自分で対処するものに印を付ける (#87) -->
                <DataTemplate x:Key="HandleCell">
                    <CheckBox IsChecked="{Binding Handled, Mode=TwoWay}"
                              HorizontalAlignment="Center" />
                </DataTemplate>

                <!--
                    種類の色を付けるのは、こちらで色を決めてよいときだけ (#121)。
                    検査結果の窓と同じ理由。種類は印と言葉でも出している
                -->
                <Style x:Key="AccentText" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                        <!--
                            **色は名前で選ぶ (#122)。**筆を束ねた値から出すと、
                            テーマが切り替わったときに前の色のまま残る。
                            資源に入れた筆には封がされ、切り替えは筆ごとの
                            差し替えになるため
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source={x:Static local:Theme.Instance}, Path=UseAccentColors}"
                                           Value="True" />
                                <Condition Binding="{Binding AccentKey}" Value="CautionBrush" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource CautionBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source={x:Static local:Theme.Instance}, Path=UseAccentColors}"
                                           Value="True" />
                                <Condition Binding="{Binding AccentKey}" Value="RuleBreakBrush" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource RuleBreakBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source={x:Static local:Theme.Instance}, Path=UseAccentColors}"
                                           Value="True" />
                                <Condition Binding="{Binding AccentKey}" Value="EncryptedBrush" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource EncryptedBrush}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>

                <DataTemplate x:Key="KindCell">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Style="{StaticResource AccentText}"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="{Binding KindText}"
                                   Style="{StaticResource AccentText}" />
                    </StackPanel>
                </DataTemplate>

                <!-- 列に収まらない長さになりやすいので、全体は説明で見せる -->
                <DataTemplate x:Key="TargetCell">
                    <TextBlock Text="{Binding Target}" ToolTip="{Binding Target}" />
                </DataTemplate>
                <DataTemplate x:Key="MessageCell">
                    <TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" />
                </DataTemplate>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <!-- 自分で対処するものに印を付ける (#87) -->
                    <GridViewColumn x:Name="HandleColumn" Width="64"
                                    CellTemplate="{StaticResource HandleCell}" />
                    <GridViewColumn x:Name="KindColumn" Width="150"
                                    CellTemplate="{StaticResource KindCell}" />
                    <GridViewColumn x:Name="TargetColumn" Width="330"
                                    CellTemplate="{StaticResource TargetCell}" />
                    <GridViewColumn x:Name="MessageColumn" Width="380"
                                    CellTemplate="{StaticResource MessageCell}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
