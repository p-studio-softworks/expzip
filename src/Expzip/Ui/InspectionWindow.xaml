<Window x:Class="Expzip.Ui.InspectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="920" Height="560"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        書庫検査の結果 (#57)。上に要約、下に「重大度 / 対象 / 内容」の一覧。
        文言はすべて ApplyLanguage が入れる。XAML には書かない (#23)
    -->
    <DockPanel>

        <!--
            要約。問題が無かった場合でも、行った検査と件数を必ず出す。
            何も出ないと検査が働いたのか分からないため
        -->
        <Border DockPanel.Dock="Top"
                Background="{x:Static SystemColors.ControlLightLightBrush}"
                BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Margin="16,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HeadlineGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock x:Name="Headline"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- 中断された場合だけ出す -->
                <TextBlock x:Name="CancelledLine"
                           Margin="24,6,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{StaticResource CautionBrush}" />
                <TextBlock x:Name="ChecksLine"
                           Margin="24,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{x:Static SystemColors.GrayTextBrush}" />
                <TextBlock x:Name="ContentsLine"
                           Margin="24,3,0,0"
                           TextWrapping="Wrap"
                           Foreground="{x:Static SystemColors.GrayTextBrush}" />
                <!-- 使えなかった場合は色を変えてはっきり出す (#56) -->
                <TextBlock x:Name="MalwareLine"
                           Margin="24,3,0,0"
                           TextWrapping="Wrap"
                           Foreground="{x:Static SystemColors.GrayTextBrush}" />
                <TextBlock x:Name="ElapsedLine"
                           Margin="24,3,0,0"
                           Foreground="{x:Static SystemColors.GrayTextBrush}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,10,16,12">
            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    Width="96" Height="26"
                    IsCancel="True"
                    Click="CloseButton_Click" />
        </Border>

        <!-- 行を選ぶと、本体側でその項目に飛ぶ -->
        <ListView x:Name="FindingList"
                  BorderThickness="0"
                  SelectionMode="Single"
                  SelectionChanged="FindingList_SelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.Resources>
                <!-- 本体の一覧と同じく、列見出しは左揃えにする -->
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="6,2" />
                </Style>

                <DataTemplate x:Key="SeverityCell">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{Binding Accent}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SeverityText}"
                                   Foreground="{Binding Accent}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>

                <!-- 列に収まらない長さになりやすいので、全体は説明で見せる -->
                <DataTemplate x:Key="TargetCell">
                    <TextBlock Text="{Binding Target}" ToolTip="{Binding Target}" />
                </DataTemplate>
                <DataTemplate x:Key="MessageCell">
                    <TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" />
                </DataTemplate>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="SeverityColumn" Width="90"
                                    CellTemplate="{StaticResource SeverityCell}" />
                    <GridViewColumn x:Name="TargetColumn" Width="300"
                                    CellTemplate="{StaticResource TargetCell}" />
                    <GridViewColumn x:Name="MessageColumn" Width="470"
                                    CellTemplate="{StaticResource MessageCell}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
