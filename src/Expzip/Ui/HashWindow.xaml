<Window x:Class="Expzip.Ui.HashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000" Height="640"
        MinWidth="520" MinHeight="420"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        ハッシュ値 (#259)。上に進み具合、真ん中に「名前 / 種類 / 値」の一覧、
        下に照らし合わせる欄。文言はすべて ApplyLanguage が入れる。XAML には書かない (#23)
    -->
    <DockPanel>

        <!-- 帯の背景色は検査結果の画面と同じ (#121) -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="16,12">
                <ProgressBar x:Name="ComputeProgress"
                             DockPanel.Dock="Right"
                             Width="180" Height="14"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Maximum="1" />
                <TextBlock x:Name="Headline"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,10,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    配布元の値を貼り付けると、一致するものを探して選ぶ。
                    見比べるのを目でやると、桁の多い値では見落とす
                -->
                <TextBlock x:Name="CompareLabel"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="CompareBox"
                         Grid.Column="1"
                         FontFamily="Consolas"
                         VerticalContentAlignment="Center"
                         TextChanged="CompareBox_TextChanged" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="12,0,0,0">
                    <Button x:Name="CopyButton"
                            MinWidth="96"
                            IsEnabled="False"
                            ToolTipService.ShowOnDisabled="True"
                            Click="CopyButton_Click" />
                    <!-- 計算の途中で閉じると中断する -->
                    <Button x:Name="CloseButton"
                            MinWidth="96"
                            Margin="8,0,0,0"
                            IsCancel="True"
                            Click="CloseButton_Click" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,6,0,0">
                    <TextBlock x:Name="CompareGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock x:Name="CompareResult"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            上に選んだファイルの一覧、下に書庫ファイルそのものの欄 (#283)。
            混ぜると、選んだより多くのファイルを計算したように見える
        -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <!-- 列のある一覧なので、Fluent のデフォルトはこちらを継承する (#122) -->
                <Style x:Key="HashRowStyle" TargetType="ListViewItem"
                       BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                    <!-- 入れておかないと、支援技術には束ねている型の名前が読まれる (#109) -->
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding RowName}" />
                    <!-- 行の間隔はメインの一覧と同じ (#131、値は App.xaml) -->
                    <Setter Property="MinHeight" Value="{StaticResource ListRowMinHeight}" />
                </Style>
                <!-- 本体の一覧と同じく、列見出しは左揃えにする -->
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="6,2" />
                </Style>

                <DataTemplate x:Key="NameCell">
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" />
                </DataTemplate>
                <!-- 桁を見比べやすいよう、値は字の幅がそろった書体で出す -->
                <DataTemplate x:Key="ValueCell">
                    <TextBlock Text="{Binding Value}" FontFamily="Consolas" />
                </DataTemplate>
            </Grid.Resources>

            <ListView x:Name="HashList"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      SelectionChanged="HashList_SelectionChanged"
                      ItemContainerStyle="{StaticResource HashRowStyle}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="NameColumn" Width="240"
                                        CellTemplate="{StaticResource NameCell}" />
                        <GridViewColumn x:Name="KindColumn" Width="80"
                                        DisplayMemberBinding="{Binding Kind}" />
                        <!-- SHA-256 の 64 桁が収まる幅 -->
                        <GridViewColumn x:Name="ValueColumn" Width="620"
                                        CellTemplate="{StaticResource ValueCell}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 書庫ファイルの欄。名前は見出しに出すので、一覧には種類と値だけ -->
            <Border x:Name="ArchivePanel"
                    Grid.Row="1"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock x:Name="ArchiveHeading"
                               Margin="8,10,8,4"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <ListView x:Name="ArchiveList"
                              BorderThickness="0"
                              SelectionMode="Extended"
                              SelectionChanged="HashList_SelectionChanged"
                              ItemContainerStyle="{StaticResource HashRowStyle}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="ArchiveKindColumn" Width="80"
                                                DisplayMemberBinding="{Binding Kind}" />
                                <GridViewColumn x:Name="ArchiveValueColumn" Width="620"
                                                CellTemplate="{StaticResource ValueCell}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
