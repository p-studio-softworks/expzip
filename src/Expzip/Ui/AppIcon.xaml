<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        アプリのアイコン (#126)。ジッパーの付いた青いフォルダー。
        **絵の正本はここだけ。**バージョン情報はこれをそのまま出し、
        exe に付ける Expzip.ico は tools/icon がこれを描き出して作る。
        絵を直したら tools/icon を走らせて ico も作り直す

        エクスプローラーの黄色いフォルダーと並んでも見分けられるよう、青にしてある。
        ほかのアーカイバのアイコンには似せない。
        ジッパーは横向きにしてある (#193)。入れ物のジッパーはたいてい横向きで、縦向きだとほかのソフトと似る

        **色みではなく明るさの差で見分けられるようにしてある。**
        1 型・2 型・3 型の色覚と明るさだけの見え方を計算して確かめた値:
          引き手と手前の青 3.73 : 1 / ジッパーの歯と手前の青 4.75 : 1 / 手前と奥 2.00 : 1
        青と黄は 3 型の色覚では見分けにくいので、色みの差に頼らない。
        色を変えるときは、この比が 3 : 1 を割らないようにする

        座標は 64 × 64 の升目で書いてある
    -->
    <DrawingImage x:Key="AppIconImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 描く範囲を 64 × 64 に固定する。無いと絵の外形で切り詰められ、中心がずれる -->
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />
                <!-- 奥の面と見出しの耳 -->
                <GeometryDrawing Brush="#163F6B"
                                 Geometry="M6,16 A4,4 0 0 1 10,12 H24 L29,17 H54 A4,4 0 0 1 58,21 V52 A4,4 0 0 1 54,56 H10 A4,4 0 0 1 6,52 Z" />
                <!-- 手前の面 -->
                <GeometryDrawing Brush="#2A6CB5">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="6,22,52,34" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- ジッパーの歯。横に通し、上下に互い違いに並べる (かばんの口のように) -->
                <GeometryDrawing Brush="#EAF2FB"
                                 Geometry="M9,28.5 h2 v4 h-2 Z M12,31.5 h2 v4 h-2 Z M15,28.5 h2 v4 h-2 Z M18,31.5 h2 v4 h-2 Z M21,28.5 h2 v4 h-2 Z M24,31.5 h2 v4 h-2 Z M27,28.5 h2 v4 h-2 Z M30,31.5 h2 v4 h-2 Z M33,28.5 h2 v4 h-2 Z M36,31.5 h2 v4 h-2 Z M39,28.5 h2 v4 h-2 Z M42,31.5 h2 v4 h-2 Z" />
                <!-- スライダーと、そこから下がる引き手 -->
                <GeometryDrawing Brush="#FFD24D">
                    <GeometryDrawing.Geometry>
                        <!-- 重なりが抜けないよう、塗り方を Nonzero にする -->
                        <GeometryGroup FillRule="Nonzero">
                            <RectangleGeometry Rect="45,27,10,10" RadiusX="2" RadiusY="2" />
                            <RectangleGeometry Rect="47.5,35,5,13" RadiusX="2" RadiusY="2" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 引き手の穴 -->
                <GeometryDrawing Brush="#7A4F00">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="49,42,2,3" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
