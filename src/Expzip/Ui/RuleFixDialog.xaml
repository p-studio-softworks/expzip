<Window x:Class="Expzip.Ui.RuleFixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1060" Height="620"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        決まりに合わせて直す (#28)。**選んだものだけを、確認してから直す。**
        既定ではどれも選ばれていない。
        文言はすべて ApplyLanguage が入れる (#23)
    -->
    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{x:Static SystemColors.ControlLightLightBrush}"
                BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Margin="16,12">
                <TextBlock x:Name="IntroText" TextWrapping="Wrap" />
                <!-- 書き換えられない書庫のときだけ出す -->
                <TextBlock x:Name="ReadOnlyText"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{StaticResource CautionBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AllButton" Width="110" Height="24" Margin="0,0,8,0"
                            Click="AllButton_Click" />
                    <Button x:Name="NoneButton" Width="110" Height="24" Margin="0,0,8,0"
                            Click="NoneButton_Click" />
                    <!-- 付け直す名前は正規表現からは出てこない。案だけ AI に出させる -->
                    <Button x:Name="NameButton" Width="200" Height="24"
                            Click="NameButton_Click" />
                    <TextBlock x:Name="NameResult" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,10,16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{x:Static SystemColors.GrayTextBrush}" />
                <Button x:Name="ApplyButton" Width="140" Height="26" Margin="0,0,8,0"
                        IsDefault="True" Click="ApplyButton_Click" />
                <Button x:Name="CloseButton" Width="96" Height="26"
                        IsCancel="True" Click="CloseButton_Click" />
            </StackPanel>
        </Border>

        <ListView x:Name="FixList"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <!--
                行の名前。入れておかないと、支援技術には束ねている型の名前が
                そのまま読まれる
            -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding Target}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="6,2" />
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <!-- 既定ではどれも入っていない。取り消せない操作のため -->
                    <GridViewColumn x:Name="UseColumn" Width="48">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay}"
                                          IsEnabled="{Binding CanChoose}"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="KindColumn" Width="90"
                                    DisplayMemberBinding="{Binding KindText}" />
                    <GridViewColumn x:Name="TargetColumn" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Target}" ToolTip="{Binding Target}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- 名前を打ち込む。打つそばから右の見込みが変わる -->
                    <GridViewColumn x:Name="NameColumn" Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NewName, Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanRename}"
                                         MinWidth="170"
                                         Padding="2,1" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ReasonColumn" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Reason}" ToolTip="{Binding Reason}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="VerdictColumn" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Verdict}" ToolTip="{Binding Verdict}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
